# Expo Go dev redirect — your machine's LAN address, must be registered
# verbatim in the Spotify developer dashboard.
#   EXPO_PUBLIC_REDIRECT_URI=exp://192.168.1.20:8082/--/callback
EXPO_PUBLIC_REDIRECT_URI=

# Base URL of the Next.js API your phone talks to during development.
#   EXPO_PUBLIC_SERVER_URL=http://192.168.1.20:3005
EXPO_PUBLIC_SERVER_URL=

# Keep development unless Spotify has approved this app for extended quota.
# This flag describes existing permission; it does not grant extra access.
EXPO_PUBLIC_SPOTIFY_QUOTA_MODE=development

# Optional private Expo Go experiment; also set by npm run start:discovery.
# Bypasses Spotify with real Deezer playlists/previews. Inactive in release builds.
# EXPO_PUBLIC_DISCOVERY_SOURCE=deezer
