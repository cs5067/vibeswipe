# vibeswipe — web app environment.
# Copy to `.env.local` and fill in. NEVER commit real values (.env* is gitignored).

# ── Spotify OAuth (https://developer.spotify.com/dashboard) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_QUOTA_MODE=development
NEXT_PUBLIC_SPOTIFY_QUOTA_MODE=development
# Match the dev script's port; register the exact callback in Spotify.
NEXT_PUBLIC_REDIRECT_URI=http://127.0.0.1:3005/api/auth/callback
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3005

# ── Supabase (https://supabase.com/dashboard → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role secret — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Last.fm (https://www.last.fm/api/account/create) — optional ──
# Powers the "people who play X also play Y" recommendation strategy.
LASTFM_API_KEY=

# ── Anthropic (optional) — AI playlist-seed interpretation ──
ANTHROPIC_API_KEY=

# ── Profile session cookie signing ──
# HMAC-SHA256 secret for the "vibeswipe_profile_id" session cookie. Leave
# empty for local dev (cookie stays a bare unsigned uuid, as before).
# REQUIRED in production (at least 32 characters; enforced by the server).
# An unsigned cookie lets anyone impersonate any
# profile id they learn. Generate with: openssl rand -hex 32
PROFILE_COOKIE_SECRET=

# ── Corpus ingest gate ──
# Legacy development gate, NOT sufficient production authentication.
# Any EXPO_PUBLIC token can be extracted from the mobile bundle. Replace
# client-submitted ingestion with a trusted server workflow before launch.
CORPUS_INGEST_TOKEN=
